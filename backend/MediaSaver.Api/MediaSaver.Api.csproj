<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>mediasaver-api-7c1e2f4a-3b9d-4e8a-9f61-2d5c8b0a1e37</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.19" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os scripts do banco vão dentro da API, que os roda ao iniciar. -->
    <EmbeddedResource Include="..\..\DataBase\Modelagem.sql" LogicalName="Modelagem.sql" />
    <EmbeddedResource Include="..\..\DataBase\DadosExemplo.sql" LogicalName="DadosExemplo.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fotos enviadas pelos usuários não fazem parte do código. -->
    <Content Remove="uploads\**" />
    <None Remove="uploads\**" />
  </ItemGroup>

</Project>
